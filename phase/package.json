{
  "name": "phase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "icons": "python3 scripts/generate-icons.py",
    "cap:sync": "npm run build && npx cap sync",
    "server": "node --disable-warning=ExperimentalWarning --import tsx server/node.ts",
    "admin": "node --disable-warning=ExperimentalWarning --import tsx server/admin.ts",
    "deploy:cloudflare": "npx wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22.5"
  }
}
